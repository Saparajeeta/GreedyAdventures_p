# Google Gemini API key (optional: if omitted, system operates in deterministic mock mode)
GOOGLE_GENERATIVE_AI_API_KEY=

# Gemini model identifier (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Groq backup provider API key
GROQ_API_KEY=

# Groq model identifier (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Primary LLM provider: google | groq (default: google)
LLM_PRIMARY=google

# Force mock mode even when API key is provided: true | false
MOCK_MODE=false
